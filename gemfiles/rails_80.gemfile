# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

gem "rake"
gem "minitest"
gem "rails", "~> 8.0.0"
gem "sqlite3", ">= 2.1"
gem "webmock"
gem "json", "< 3" # json 3 dropped the quirks_mode option this Rails line passes
gem "rubocop-rails-omakase", require: false
gem "bundler-audit", require: false
